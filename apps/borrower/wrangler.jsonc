{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "7ca70a1deedbffff10d49a5e395aa978",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "name": "keycade-borrower",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "keycade-api"
    }
  ]
}
