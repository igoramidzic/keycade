{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "7ca70a1deedbffff10d49a5e395aa978",
  "main": "worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "name": "keycade-jobs",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "2aa8c3bf77af4beb8208f07007fada92"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "keycade-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "keycade-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 10
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "SIMULATION_DELAY_MS": "2000",
    "PROVIDER_DEADLINE_MS": "60000",
    "DEMO_INBOX_ENABLED": "true",
    "BORROWER_ORIGIN": "https://keycade-borrower.kualia.workers.dev",
    "REMINDER_FIRST_DELAY_MS": "86400000",
    "REMINDER_SECOND_DELAY_MS": "259200000"
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "keycade-private-documents"
    }
  ],
  "secrets": {
    "required": ["ENCRYPTION_KEY"]
  }
}
