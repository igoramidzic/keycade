{
  "name": "@keylend/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts"
  },
  "dependencies": {
    "@keylend/config": "workspace:*",
    "@keylend/contracts": "workspace:*",
    "@keylend/db": "workspace:*",
    "@keylend/domain": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5",
    "@keylend/integrations": "workspace:*"
  }
}
