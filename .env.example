# Local-only development. pnpm initialize copies this and fills missing secrets.
NODE_ENV=development
PROJECT_NAME=keycade
PODMAN_MACHINE=podman-machine-default
DB_HOST=127.0.0.1
DB_PORT=54329
DB_NAME=keycade
DB_USER=keycade
DB_PASSWORD=
DATABASE_URL=
POSTGRES_IMAGE=docker.io/library/postgres:18.6-alpine
MAILPIT_IMAGE=docker.io/axllent/mailpit:v1.29.2
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=4000
BANK_SITE_PORT=3000
BORROWER_PORT=3001
BANK_CONSOLE_PORT=3002
SESSION_SECRET=
ENCRYPTION_KEY=
PRIVATE_STORAGE_PATH=.local/uploads
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_MAX_BATCH_FILES=10
SIMULATION_DELAY_MS=3000
PROVIDER_DEADLINE_MS=10000
JOB_MAX_ATTEMPTS=3
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_MS=2000
WORKER_STALE_MS=15000

# Demo inactivity reminders; the second threshold must follow the first.
REMINDER_FIRST_DELAY_MS=86400000
REMINDER_SECOND_DELAY_MS=259200000

# Optional in-app simulated inbox for hosted-parity testing; default local delivery stays in Mailpit.
DEMO_INBOX_ENABLED=false
